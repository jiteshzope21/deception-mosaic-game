# ─── MOSAIC — Backend Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in the values before starting the server.
# NEVER commit .env to version control.

# ─── MongoDB ────────────────────────────────────────────────────────────────────
# Local MongoDB (use MongoDB Atlas URI for production)
MONGODB_URI=mongodb://localhost:27017/mosaic
MONGODB_DB_NAME=mosaic

# ─── JWT ─────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING_64_CHARS
JWT_GM_EXPIRY=8h
JWT_PLAYER_EXPIRY=4h

# ─── Server ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── GM Account Seed ──────────────────────────────────────────────────────────────
# Used by: npx tsx src/seed.ts
# Change these before seeding in production!
GM_EMAIL=organizer@adg.org
GM_PASSWORD=ChangeMe_ADG2024!
GM_DISPLAY_NAME=Game Master
